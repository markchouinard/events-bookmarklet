{
	"version": 2,
	"rewrites": [
		{
			"source": "/extract-event",
			"destination": "/api/extract-event"
		},
		{
			"source": "/submit-to-wordpress",
			"destination": "/api/submit-to-wordpress"
		},
		{
			"source": "/test-wordpress",
			"destination": "/api/test-wordpress"
		},
		{
			"source": "/check-events-api",
			"destination": "/api/check-events-api"
		}
	],
	"outputDirectory": "dist",
	"functions": {
		"api/*.ts": {
			"includeFiles": "dist/**"
		}
	}
}
